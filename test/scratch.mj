package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;
import rs.etf.pp1.symboltable.concepts.*;

parser code {:

	Logger log = Logger.getLogger(getClass());  
    
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }
:}


scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}


terminal PROGRAM;
terminal PRINT;
terminal READ;
terminal NEW;
terminal ADD;
terminal SUB;
terminal MUL;
terminal DIV;
terminal MOD;
terminal INC;
terminal DEC;
terminal ASSIGN;
terminal SEMICOLON;
terminal COMMA;
terminal LPAREN;
terminal RPAREN;
terminal LSQUARE;
terminal RSQUARE;
terminal LBRACE;
terminal RBRACE;
terminal CONST_MODIFIER;
terminal TRUE;
terminal FALSE;
terminal Integer NUMBER;
terminal String IDENT;
terminal String CHAR;

nonterminal ConstSymbol;
nonterminal VarSymbolList;
nonterminal MethodList;
nonterminal FormPars;
nonterminal StatementList;
nonterminal Statement;
nonterminal MultiDesignator;
nonterminal TermList;
nonterminal FactorList;
nonterminal Addop;
nonterminal Mulop;

nonterminal rs.etf.pp1.symboltable.concepts.Obj Program;
nonterminal rs.etf.pp1.symboltable.concepts.Obj ProgramName;
nonterminal rs.etf.pp1.symboltable.concepts.Obj ConstSymbol;
nonterminal rs.etf.pp1.symboltable.concepts.Obj VarSymbol;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Method;
nonterminal rs.etf.pp1.symboltable.concepts.Obj MethodTypeName;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Designator;

nonterminal rs.etf.pp1.symboltable.concepts.Struct Type;
nonterminal rs.etf.pp1.symboltable.concepts.Struct VarDecl;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Term;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Factor;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Expr;

start with Program;

Program ::= (Program) PROGRAM ProgramName:programName DeclList LBRACE MethodList RBRACE;
ProgramName ::= (ProgramName) IDENT:name;

DeclList ::= (DeclListConstNext) DeclList ConstSymbol
				|	(DeclListVarNext) DeclList VarDecl
				|	(DeclListEmpty) /* or empty */;

ConstSymbol ::= (ConstSymbol) CONST_MODIFIER Type:typeName IDENT:symbolName ASSIGN NUMBER:value SEMICOLON;

VarDecl ::=  (VarDecl) Type:typeName VarSymbolList:VarListNext SEMICOLON;
VarSymbolList ::= (VarListNext) VarSymbolList COMMA VarSymbol:varSymbol
				| (VarListLast) VarSymbol:varSymbol;
			
VarSymbol ::= (VarIdent) IDENT:symbolName
			| (VarArray) IDENT:symbolName LSQUARE RSQUARE
			| (VarMatrix) IDENT:symbolName LSQUARE RSQUARE LSQUARE RSQUARE;

Type ::= (Type) IDENT:typeName;

MethodList ::= (MethodListNext) MethodList Method
			|(MethodListEmpty) /* or empty */;
			
Method ::= (Method) MethodTypeName:methodTypeName LPAREN FormPars RPAREN DeclList LBRACE StatementList RBRACE;
MethodTypeName ::= (MethodTypeName) Type:returnType IDENT:name;
FormPars ::= (FormPars) /* empty for now */;

StatementList ::= (StatementListNext) StatementList Statement
				|	(StatementListEmpty) /* or empty */;
			
Statement ::= (StatementAssignExpr) Designator ASSIGN Expr SEMICOLON
			| (StatementMultiAssign) LSQUARE MultiDesignator RSQUARE ASSIGN Designator SEMICOLON
			| (StatementInc) Designator INC SEMICOLON
			| (StatementDec) Designator DEC SEMICOLON
			| (StatementPrint) PRINT LPAREN Expr RPAREN SEMICOLON
			| (StatementPrintWidth) PRINT LPAREN Expr COMMA NUMBER:width RPAREN SEMICOLON
			| (StatementRead) READ LPAREN Designator RPAREN SEMICOLON
			| (StatementNewArray) Designator ASSIGN NEW Type LSQUARE Expr RSQUARE SEMICOLON
			| (StatementNewMatrix) Designator ASSIGN NEW Type LSQUARE Expr:rowNum RSQUARE LSQUARE Expr:colNum RSQUARE SEMICOLON;
			
MultiDesignator ::= (MultiDesignatorWithDesignator) Designator COMMA MultiDesignator
			| (MultiDesignatorSkip) COMMA MultiDesignator
			| (MultiDesignatorLast) Designator
			| (MultiDesignatorLastComma) Designator COMMA;

Designator ::= (DesignatorIdent) IDENT:designatorName
			| (DesignatorArray) IDENT:arrayName LSQUARE Expr RSQUARE
			| (DesignatorMatrix) IDENT:matrixName LSQUARE Expr RSQUARE LSQUARE Expr RSQUARE;


Expr ::= (Expr) Term TermList;

TermList ::= (TermListNext) TermList Addop:operator Term
			| (TermListEmpty) /* or empty */;

Addop ::= (AddopAdd) ADD
			| (AddopSub) SUB;

Term ::= (TermBasic) Factor FactorList
			| (TermNegative) SUB Factor FactorList;

FactorList ::= (FactorListNext) FactorList Mulop:operator Factor
			| (FactorListempty) /* or empty */;

Mulop ::= (MulopMul) MUL
			| (MulopDiv) DIV
			| (MulopMod) MOD;

Factor ::= (FactorNumber) NUMBER:value
			| (FactorChar) CHAR:value
			| (FactorDesignator) Designator:symbolName
			| (FactorExpr) LPAREN Expr RPAREN;




	private void checkMultiDesignator(MultiDesignator multiDesignator, Struct type, SyntaxNode node) {
		if (!(multiDesignator instanceof MultiDesignatorSkip)) { // Has a designator
			Designator designator; // Designator from the left side
			if (multiDesignator instanceof MultiDesignatorWithDesignator) {
				designator = ((MultiDesignatorWithDesignator) multiDesignator).getDesignator();
			} else if (multiDesignator instanceof MultiDesignatorLast) {
				designator = ((MultiDesignatorLast) multiDesignator).getDesignator();
			} else { // MultiDesignatorLastComma
				designator = ((MultiDesignatorLastComma) multiDesignator).getDesignator();
			}

			// Must match the right side array element type
			if (designator instanceof DesignatorIdent) {
				if (!type.equals(designator.obj.getType())) {
					showError("\"" + ((DesignatorIdent) designator).getDesignatorName() + "\" treba da bude tipa "
							+ structToTypeName(type), node);
				}
			} else {
				if (!type.equals(designator.obj.getType().getElemType())) {
					showError("\"" + ((DesignatorArray) designator).getArrayName()
							+ "\" treba da bude niz tipa " + structToTypeName(type), node);
				}
			}

			if (multiDesignator instanceof MultiDesignatorWithDesignator) {
				checkMultiDesignator(((MultiDesignatorWithDesignator) multiDesignator).getMultiDesignator(), type,
						node);
			}
		} else { // Skip
			checkMultiDesignator(((MultiDesignatorSkip) multiDesignator).getMultiDesignator(), type, node);
		}
	}

	// Deprecated
	public void visit(StatementMultiAssign statement) {
		Struct arrayType = statement.getDesignator().obj.getType();
		if (arrayType.getKind() == Struct.Array) {
			checkMultiDesignator(statement.getMultiDesignator(), arrayType.getElemType(), statement);
		} else {
			if (statement.getDesignator() instanceof DesignatorIdent) {
				showError(
						"\"" + ((DesignatorIdent) statement.getDesignator()).getDesignatorName() + "\" mora biti niz",
						statement);
			} else {
				showError("\"" + ((DesignatorArray) statement.getDesignator()).getArrayName()
						+ "\" mora biti niz, a ne element niza", statement);
			}
		}
	}