// Test301

program test301

	const int nula = 0;
	const int jedan = 1;
	const int pet = 5;

	int niz[];
	char nizch[];
	int mat[][];

	int a;
	
{
	void main()	
		int bodovi;
		bool bt;
	{

		// Bodovi
		// bodovi = (((0 + 1) + 1) * 5) - 1 = 10 - 1 = 9
		bodovi = 0;
		bodovi++;
		bodovi = bodovi + jedan;
		bodovi = bodovi * pet;
		bodovi--;
		print(bodovi); // Supposed to be 9	

		// Nizovi
		// niz[0] = 1
		// niz[1] = 2
		// niz[2] = niz[1] * 3 = 6
		// bodovi = 6 / 1 = 6
		niz = new int[3];
		niz[nula] = jedan;
		niz[1] = 2;
		niz[niz[jedan]] = niz[niz[0]] * 3;
		bodovi = niz[2]/niz[0];
		print(bodovi);
		print(niz[2]);

		// Karakterni Nizovi
		nizch = new char[3];
		nizch[0] = 'a';
		nizch[jedan] = 'b';
		nizch[pet - 3] = 'c';
		print(nizch[1]);
		print(nizch[jedan * 2]);

		// Read bodovi
		// Bodovi se ovde ne racunaju, uvek je rezultat -4
		// bodovi = -bodovi + 1 * bodovi - 4
		a=1;
		read(bodovi);
		bodovi = -bodovi + (pet * a / 2 - jedan) * bodovi - (3 % 2 + 3 * 2 - 3); 
		print(bodovi);

		// Matrix
		mat = new int[2][3];
		mat[nula][jedan - 1] = jedan; // mat[0][0] = 1
		mat[0][mat[0][0]] = 2;        // mat[0][1] = 2
		mat[0][mat[0][1]] = 5;        // mat[0][2] = 5
		mat[1][mat[0][0]*2] = 4;      // mat[1][2] = 4
		mat[mat[0][0]][1] = 3;        // mat[1][1] = 3
		mat[1][0] = 2;                // mat[1][0] = 2
		
		print(mat[1][2]); // 4
		print(mat[0][2]); // 5
	}
}